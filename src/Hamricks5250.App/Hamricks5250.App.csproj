<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hamricks5250.App</RootNamespace>
    <AssemblyName>Ham5250</AssemblyName>
    <ApplicationIcon>Assets\hamricks.ico</ApplicationIcon>
    <StartupObject>Hamricks5250.App.Program</StartupObject>
    <Version>1.0.0</Version>
    <Company>Night Tech Solutions</Company>
    <Product>Ham 5250</Product>
    <Authors>Jason Scates</Authors>
    <Copyright>Built by Night Tech Solutions for Hamrick's, Inc.</Copyright>
    <Description>Ham 5250 - IBM i terminal</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hamricks5250.Core\Hamricks5250.Core.csproj" />
    <Resource Include="Assets\hamricks.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
